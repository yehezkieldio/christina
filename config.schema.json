{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConfigFile",
  "description": "On-disk configuration representation (serde-friendly)",
  "type": "object",
  "properties": {
    "advanced": {
      "description": "Advanced settings",
      "default": {
        "commit_history_depth": 5,
        "lockfile_token_limit": 100,
        "max_concurrent_requests": 4,
        "max_partial_failure_rate": 0.1,
        "prompt_failure_rate_threshold": 0.05,
        "use_commit_history": true
      },
      "allOf": [
        {
          "$ref": "#/definitions/AdvancedConfig"
        }
      ]
    },
    "experimental": {
      "description": "Experimental settings (opt-in)",
      "default": {
        "free_tier": {
          "commit_history_depth": 3,
          "max_concurrent_requests": 1,
          "max_input_tokens": 16000,
          "max_output_tokens": 512
        },
        "usage_tier": "standard",
        "use_experimental": false
      },
      "allOf": [
        {
          "$ref": "#/definitions/ExperimentalConfig"
        }
      ]
    },
    "profiles": {
      "description": "Provider profiles",
      "default": {
        "active": null
      },
      "allOf": [
        {
          "$ref": "#/definitions/Profiles_for_String"
        }
      ]
    },
    "schema_version": {
      "description": "Schema version for config file format migrations",
      "default": 2,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "standard": {
      "description": "Standard settings",
      "default": {
        "active_profile": null,
        "commit_message_max_length": null,
        "commit_message_validation_mode": "soft",
        "ignore_files": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/StandardConfig"
        }
      ]
    }
  },
  "definitions": {
    "AdvancedConfig": {
      "description": "Advanced configuration settings.",
      "type": "object",
      "properties": {
        "commit_history_depth": {
          "description": "Number of recent commits to include for style analysis",
          "default": 5,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "lockfile_token_limit": {
          "description": "Maximum tokens to include from lockfiles when truncating",
          "default": 100,
          "allOf": [
            {
              "$ref": "#/definitions/TokenCount"
            }
          ]
        },
        "max_concurrent_requests": {
          "description": "Maximum concurrent LLM requests",
          "default": 4,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "max_partial_failure_rate": {
          "description": "Maximum allowed fraction of chunk failures before aborting map phase",
          "default": 0.1,
          "type": "number",
          "format": "double"
        },
        "prompt_failure_rate_threshold": {
          "description": "Failure rate threshold for prompting user confirmation",
          "default": 0.05,
          "type": "number",
          "format": "double"
        },
        "use_commit_history": {
          "description": "Whether to include commit history context in LLM prompts",
          "default": true,
          "type": "boolean"
        }
      }
    },
    "ExperimentalConfig": {
      "description": "Experimental configuration settings (opt-in).",
      "type": "object",
      "properties": {
        "free_tier": {
          "description": "Free-tier limits applied when usage_tier is set to free",
          "default": {
            "commit_history_depth": 3,
            "max_concurrent_requests": 1,
            "max_input_tokens": 16000,
            "max_output_tokens": 512
          },
          "allOf": [
            {
              "$ref": "#/definitions/FreeTierLimits"
            }
          ]
        },
        "usage_tier": {
          "description": "Usage tier for rate-limit-aware defaults",
          "default": "standard",
          "allOf": [
            {
              "$ref": "#/definitions/UsageTier"
            }
          ]
        },
        "use_experimental": {
          "description": "Enable experimental settings (default: false)",
          "default": false,
          "type": "boolean"
        }
      }
    },
    "FreeTierLimits": {
      "description": "Limits applied to the free usage tier.",
      "type": "object",
      "properties": {
        "commit_history_depth": {
          "default": 3,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "max_concurrent_requests": {
          "default": 1,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "max_input_tokens": {
          "default": 16000,
          "allOf": [
            {
              "$ref": "#/definitions/TokenCount"
            }
          ]
        },
        "max_output_tokens": {
          "default": 512,
          "allOf": [
            {
              "$ref": "#/definitions/TokenCount"
            }
          ]
        }
      }
    },
    "ModelName": {
      "description": "LLM model identifier (e.g., 'gpt-4', 'claude-3-opus')",
      "type": "string"
    },
    "Profiles_for_String": {
      "description": "Collection of provider profiles with an active profile selection.\n\nGeneric parameter `S` determines secret storage strategy: - `S = String`: Direct string values, serializable - `S = SecretRef`: References to secrets (env vars, keyring), serializable - `S = SecretString`: Resolved secret values, NOT serializable\n\nThe `definitions` field uses serde's `flatten` attribute to serialize profiles directly into the parent config structure, enabling TOML files like: ```toml [profiles.default] provider = \"openai\" model = \"gpt-4\" ```\n\nSee module-level documentation for usage patterns and best practices.",
      "type": "object",
      "properties": {
        "active": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ProviderKind": {
      "description": "Supported LLM API providers.\n\nThis enum drives client instantiation and request formatting. Each variant corresponds to a distinct API contract.",
      "type": "string",
      "enum": [
        "openai",
        "azure",
        "groq"
      ]
    },
    "ProviderProfile_for_String": {
      "description": "Configuration for an LLM provider (API credentials, model, token limits).\n\nGeneric parameter `S` determines secret storage strategy: - `S = String` or `S = SecretRef`: Disk storage, fully serializable - `S = SecretString`: Runtime secrets, NOT serializable\n\nSee module-level documentation for detailed usage patterns.",
      "type": "object",
      "required": [
        "api_key",
        "max_input_tokens",
        "max_output_tokens",
        "model",
        "name",
        "provider"
      ],
      "properties": {
        "api_key": {
          "$ref": "#/definitions/Secret_for_String"
        },
        "api_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "azure_api_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "azure_deployment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_input_tokens": {
          "$ref": "#/definitions/TokenCount"
        },
        "max_output_tokens": {
          "$ref": "#/definitions/TokenCount"
        },
        "model": {
          "$ref": "#/definitions/ModelName"
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/definitions/ProviderKind"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      }
    },
    "Secret_for_String": {
      "description": "Generic secret container\n\n**Important**: This type implements a custom Debug impl that redacts all secrets for security. To access secret values, use `expose_secret()` or resolver methods.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "env"
          ],
          "properties": {
            "env": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "keyring"
          ],
          "properties": {
            "keyring": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "StandardConfig": {
      "description": "Standard (common) configuration settings.",
      "type": "object",
      "properties": {
        "active_profile": {
          "description": "Active profile name (preferred over profiles.active)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "commit_message_max_length": {
          "description": "Maximum commit message length (None = 72)",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "commit_message_validation_mode": {
          "description": "Validation mode for commit message length",
          "default": "soft",
          "allOf": [
            {
              "$ref": "#/definitions/ValidationMode"
            }
          ]
        },
        "ignore_files": {
          "description": "Files to exclude from AI processing",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TokenCount": {
      "description": "Count of tokens in text, guaranteed to be non-zero.\n\nWHY NonZeroU32: Empty text is never valid input for token-counting operations. By using NonZeroU32, we: 1. Eliminate defensive checks for zero throughout the codebase 2. Enable compiler optimizations (Option<TokenCount> is the same size as u32) 3. Make the domain constraint explicit in the type system\n\nWHY saturating arithmetic: When token counts are computed from potentially malicious or corrupted input, clamping to NonZeroU32::MIN (1) is safer than panicking or wrapping. This ensures the system remains operational even with bad data, trading precision for resilience.",
      "type": "integer",
      "format": "uint32",
      "minimum": 1.0
    },
    "UsageTier": {
      "description": "Usage tier for rate-limit-aware defaults.",
      "type": "string",
      "enum": [
        "standard",
        "free"
      ]
    },
    "ValidationMode": {
      "description": "Validation mode for commit message length checks.\n\nWHY three modes: Different teams have different policies. Strict enforces limits (CI integration), Soft guides without blocking (developer experience), Disabled allows custom workflows (automated tools, migrations).",
      "oneOf": [
        {
          "description": "Reject messages exceeding the limit",
          "type": "string",
          "enum": [
            "strict"
          ]
        },
        {
          "description": "Warn but allow messages exceeding the limit",
          "type": "string",
          "enum": [
            "soft"
          ]
        },
        {
          "description": "Skip length check entirely",
          "type": "string",
          "enum": [
            "disabled"
          ]
        }
      ]
    }
  }
}