{
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "turbo": "^2.5.8",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0"
  },
  "name": "charlotte",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "compile": "bun --filter @charlotte/cli compile",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "turbo run typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3"
    }
  },
  "type": "module"
}
